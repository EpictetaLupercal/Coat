<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Coat</AssemblyName>
    <RootNamespace>Coat</RootNamespace>
    <Version>1.7.2</Version>
    <ApplicationIcon>Assets\Coat.ico</ApplicationIcon>
    <Authors>Epicteta Lupercal</Authors>
    <Company>Epicteta Lupercal</Company>
    <Copyright>Epicteta Lupercal</Copyright>
    <Description>Coat — 2D level design plan and blueprint editor by Epicteta Lupercal</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Locales/en.json" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.6" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup><Resource Include="..\docs\images\coat-logo.png" Link="Assets\CoatLogo.png" /></ItemGroup>
  <ItemGroup><Content Include="..\sounds\*.wav" Link="sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <Content Include="..\third-party\PresentMon\PresentMon.exe;..\third-party\PresentMon\LICENSE.txt" Link="third-party\PresentMon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

